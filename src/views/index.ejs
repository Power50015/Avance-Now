<!-- Declare document type as standard HTML5 to ensure correct rendering in web browsers -->
<!DOCTYPE html>
<!-- Set root language as English and default theme state as light theme for DaisyUI styling -->
<html lang="en" data-theme="light">
<!-- Contain document metadata, links to styles, and browser settings -->
<head>
  <!-- Set character encoding to standard UTF-8 for international character support -->
  <meta charset="UTF-8">
  <!-- Ensure responsive, mobile-first design scaling on various mobile device screen widths -->
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <!-- Set browser tab page title to 'avance-now' -->
  <title>avance-now</title>
  <!-- Load DaisyUI component styles from cdnjs/npm to style elements like buttons and heroes -->
  <link href="https://cdn.jsdelivr.net/npm/daisyui@4/dist/full.min.css" rel="stylesheet">
  <!-- Load Tailwind CSS framework engine dynamically from standard CDN link -->
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<!-- Root layout element holding the visual document content -->
<body>
  <!-- Render a centered viewport-filling hero banner container with a modern off-white background color -->
  <div class="hero min-h-screen bg-base-200">
    <!-- Center-align all text content components embedded inside the hero view -->
    <div class="hero-content text-center">
      <!-- Restrict the text block size width to a maximum size of medium (max-w-md) -->
      <div class="max-w-md">
        <!-- Display the prominent, high-level header title 'avance-now' in bold font sizes -->
        <h1 class="text-5xl font-bold">avance-now</h1>
        <!-- Describe the core tech stack platform specifications in a readable large text block -->
        <p class="py-6 text-lg">Modular, extensible platform. Built with TypeScript, Fastify, and PostgreSQL.</p>
        <!-- Place interactive navigation button options in a centered, flexible, gap-spaced row layout -->
        <div class="flex gap-4 justify-center">
          <!-- Create primary colored button linking clients directly to the discovery endpoint /api -->
          <a href="/api" class="btn btn-primary">API Info</a>
          <!-- Create outline styled button linking clients directly to the diagnostic check endpoint /health -->
          <a href="/health" class="btn btn-outline">Health Check</a>
        </div>
        <!-- Align environment context variables vertically below standard details inside a semi-transparent text zone -->
        <div class="mt-8 text-sm opacity-70">
          <!-- Render the active execution node environment using dynamic EJS template interpolation -->
          <p>Environment: <%= locals.config?.nodeEnv || 'development' %></p>
          <!-- Display the server-side generation timestamp via inline evaluation of a new JavaScript Date instance -->
          <p>Server Time: <%= new Date().toISOString() %></p>
        </div>
      </div>
    </div>
  </div>
</body>
</html>


# Application
AVN_NODE_ENV=development
AVN_PORT=3000
AVN_HOST=0.0.0.0
AVN_LOG_LEVEL=info
AVN_ENABLE_VIEWS=true
AVN_ENABLE_DEBUG=true
AVN_TRUST_PROXY=false
AVN_CORS_ORIGIN=*
AVN_RATE_LIMIT_MAX=100
AVN_KEEPALIVE_TIMEOUT=5000

# Database
AVN_DB_HOST=postgres
AVN_DB_PORT=5432
AVN_DB_NAME=avance_now
AVN_DB_USER=avn_user
AVN_DB_PASSWORD=devpassword

# Session
AVN_SESSION_SECRET=change-this-to-a-random-secret-in-production

# Redis (optional - uncomment to enable)
# AVN_REDIS_HOST=redis
# AVN_REDIS_PORT=6379
